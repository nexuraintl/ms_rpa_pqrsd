# =============================================================================
# ms_rpa_pqrsd — variables de entorno
# Copiar a .env para desarrollo local. NUNCA commitear el .env real.
# En Cloud Run estas variables se definen con --set-env-vars.
#
# Este servicio consume un portal público y NO maneja credenciales:
# no hay entradas en Secret Manager. Si en el futuro el portal exige
# autenticación, la credencial va a Secret Manager, nunca aquí.
# =============================================================================

# --- Identidad del servicio (exigidas por GOB-GCP-STD-01) --------------------
# Nombre del servicio; se expone en /version y en cada log.
SERVICE_NAME=ms-rpa-pqrsd
# Versión desplegada. En CI se sobrescribe con el tag o el commit SHA.
SERVICE_VERSION=1.0.0
# Ambiente de ejecución: dev | qa | preprod | prod
ENVIRONMENT=dev
# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Proyecto GCP; necesario para que Cloud Logging correlacione logs y trazas.
GOOGLE_CLOUD_PROJECT=

# --- Portal Suite Neptuno (Alcaldía de Floridablanca) ------------------------
# URL de la vista de consulta de correspondencia.
PORTAL_CONSULTA_URL=https://portal.floridablanca.suiteneptuno.com/Correspondencia/Consulta/Consulta
# URL de la vista de radicación (también sirve los catálogos).
PORTAL_RADICACION_URL=https://portal.floridablanca.suiteneptuno.com/Correspondencia/Radicacion/Radicacion
# User-Agent enviado al portal. El portal rechaza clientes sin UA de navegador.
PORTAL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# --- Cliente HTTP saliente ---------------------------------------------------
# Timeout total por petición al portal, en segundos.
HTTP_TIMEOUT_SECONDS=30
# Timeout solo para el establecimiento de conexión.
HTTP_CONNECT_TIMEOUT_SECONDS=10
# Reintentos adicionales para peticiones idempotentes (GET). La radicación
# nunca se reintenta: duplicaría el radicado en el portal.
HTTP_MAX_RETRIES=2
# Tamaño del pool de conexiones salientes.
HTTP_MAX_CONNECTIONS=20
HTTP_MAX_KEEPALIVE_CONNECTIONS=10

# --- Caché de catálogos ------------------------------------------------------
# Segundos que se conservan los catálogos en memoria antes de volver a pedirlos.
# 0 desactiva la caché (no recomendado: son 7 peticiones al portal por request).
CATALOGOS_CACHE_TTL_SECONDS=300

# --- Límites de anexos -------------------------------------------------------
# Número máximo de archivos por radicación.
MAX_UPLOAD_FILES=10
# Tamaño máximo por archivo, en bytes (10 MB).
MAX_UPLOAD_BYTES=10485760
# Tamaño máximo acumulado de todos los anexos, en bytes (25 MB).
MAX_UPLOAD_TOTAL_BYTES=26214400

# --- CORS --------------------------------------------------------------------
# Orígenes permitidos, separados por coma. Vacío = CORS deshabilitado, que es
# lo correcto detrás del API Gateway. Ejemplo: https://portal.nexura.com
# Usar "*" desactiva automáticamente allow_credentials (los navegadores no
# aceptan comodín con credenciales).
CORS_ALLOW_ORIGINS=

# --- Diagnóstico -------------------------------------------------------------
# Incluye el payload crudo del portal en la respuesta de /v1/pqrsd/crear.
# Debe permanecer en false fuera de dev: expone datos personales del ciudadano.
EXPOSE_RAW_RESPONSE=false
